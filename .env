# ─────────────────────────────────────────────────────────────
# dactil-lambda-configuration — configuración
# Copia este archivo a .env y ajústalo. Se empaqueta en el zip y se carga
# con parseDotEnv() al arrancar (o pásalo como variables de entorno de la función).
# ─────────────────────────────────────────────────────────────

# --- AWS / DynamoDB ---
AWS_REGION=us-east-1
# Endpoint de DynamoDB. Vacío = DynamoDB real de AWS.
# Para probar con DynamoDB Local: http://localhost:8000
DDB_ENDPOINT=
# Nombres de las 3 tablas (créalas con deploy/setup-dynamodb.sh)
DDB_TABLE_COMPANIES=dactil-companies
DDB_TABLE_USERS=dactil-users
DDB_TABLE_CHANNELS=dactil-channels
# En Lambda las credenciales vienen del rol de ejecución.
# En local: exporta AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY o usa AWS_PROFILE.

# --- Autenticación de la API ---
# true  -> exige  Authorization: Bearer <jwt HS256>  y lo valida con JWT_SECRET
# false -> API abierta (MVP)
REQUIRE_AUTH=true
# NO pongas el secreto real aquí (este archivo está versionado en git).
# Debe ser IDÉNTICO al JWT_SECRET de lambda-authenticator (mismo emisor del token).
# Se configura como variable de entorno de la función Lambda en AWS, no en este archivo.
JWT_SECRET=

# --- Hash de contraseñas ---
# Pimienta opcional que se concatena al hashear (scrypt). Guárdala fuera del código.
PASSWORD_PEPPER=

# --- Correo de bienvenida (AWS SES v2) ---
EMAIL_ENABLED=true
SES_REGION=us-east-1
# La direccion "From" debe estar verificada en SES (deploy/setup-ses.sh).
EMAIL_FROM=gestion.dactil@gmail.com
EMAIL_FROM_NAME=Dactil
# URL base del portal para armar el enlace de activacion: {PORTAL_BASE_URL}/activar?email=...
PORTAL_BASE_URL=http://localhost:4200

# --- Aprovisionamiento de canales S3 (AWS S3 real) ---
# true  -> al crear/editar un canal tipo s3 se crea el bucket real en AWS si no existe
# false -> solo se guarda la configuracion, sin tocar S3 (dev sin credenciales AWS)
S3_PROVISIONING_ENABLED=true

# --- CORS ---
CORS_ORIGIN=*
